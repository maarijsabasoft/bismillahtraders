# --- Mongo API (server only: Vercel env + `vercel dev`) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=yourApp
MONGODB_DB_NAME=bismillah_traders

# Optional: shorter/longer Mongo driver timeouts (ms). On Vercel, defaults stay under ~10s Hobby function limit.
# MONGODB_SERVER_SELECTION_MS=7000
# MONGODB_CONNECT_MS=7000
# MONGODB_SOCKET_MS=10000

# Vercel defaults: driver uses IPv4 (family 4) + Node DNS ipv4first. Override:
# MONGODB_DNS_FAMILY=0   # omit driver family (keep ipv4first unless MONGODB_DNS_V4FIRST=0)
# MONGODB_DNS_FAMILY=6   # force IPv6
# MONGODB_DNS_V4FIRST=0  # disable dns.setDefaultResultOrder('ipv4first')

# On Vercel, Mongo Stable API is OFF unless you set:
# MONGODB_USE_SERVER_API=1
# Non-Vercel: Stable API ON unless MONGODB_DISABLE_SERVER_API=1
# MONGODB_DISABLE_SERVER_API=1

# DEBUG ONLY if TLS still fails after deploy (remove after testing — insecure):
# MONGODB_TLS_ALLOW_INVALID=1

# If SRV keeps failing, paste Atlas "standard connection string" (mongodb://host1,host2,host3/...) as MONGODB_URI.

# Optional: Mongo API handler retries (default 2). Raise only on Pro + higher maxDuration.
# MONGODB_HANDLER_MAX_ATTEMPTS=3

# Optional: driver connection pool size (default 5). Lower if Atlas hits connection limits.
# MONGODB_MAX_POOL_SIZE=3

# Optional: verbose Mongo API route logs
# DEBUG_MONGO_API=1

# Default on Vercel: each API request uses a new Mongo client (avoids TLS "alert 80" on reused sockets).
# Set to 1 only if stable and you want faster dashboard (reuses pooled client).
# MONGODB_REUSE_CLIENT=1

# Must match REACT_APP_ADMIN_* below (same username/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password

# --- React build (Vercel "Environment Variables" for Production + Preview) ---
REACT_APP_USE_MONGODB=true
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=change_this_strong_password

# Optional full URL if API is not same-origin
# REACT_APP_API_URL=https://your-app.vercel.app/api/db/mongodb

# Optional: client fetch timeout ms (default 90000) if dashboard loads hit "Request timeout"
# REACT_APP_MONGO_FETCH_TIMEOUT_MS=90000

# --- Optional: `npm start` while API runs elsewhere (e.g. second terminal `vercel dev`) ---
# DEV_API_PROXY=http://localhost:3000
