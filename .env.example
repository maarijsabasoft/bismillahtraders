# --- Mongo API (server only: Vercel env + `vercel dev`) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=yourApp
MONGODB_DB_NAME=bismillah_traders

# Must match REACT_APP_ADMIN_* below (same username/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password

# --- React build (Vercel "Environment Variables" for Production + Preview) ---
REACT_APP_USE_MONGODB=true
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=change_this_strong_password

# Optional full URL if API is not same-origin
# REACT_APP_API_URL=https://your-app.vercel.app/api/db/mongodb

# --- Optional: `npm start` while API runs elsewhere (e.g. second terminal `vercel dev`) ---
# DEV_API_PROXY=http://localhost:3000
